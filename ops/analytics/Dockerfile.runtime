FROM node:22-bookworm-slim AS builder

ARG PNPM_VERSION=10.15.1
WORKDIR /app
ENV BASE_PATH=/analytics
ENV DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/placeholder
ENV SKIP_DB_CHECK=1
ENV SKIP_DB_MIGRATION=1
ENV NEXT_TELEMETRY_DISABLED=1
ENV DISABLE_TELEMETRY=1

COPY . .
RUN corepack pnpm@${PNPM_VERSION} install --frozen-lockfile
RUN NODE_OPTIONS=--max-old-space-size=2048 corepack pnpm@${PNPM_VERSION} build
RUN mkdir -p /runtime/.next/static \
    && cp -a .next/standalone/. /runtime/ \
    && cp -a .next/static/. /runtime/.next/static/ \
    && cp -a public /runtime/public \
    && if [ -d geo ]; then cp -a geo /runtime/geo; fi

FROM busybox:1.37
COPY --from=builder /runtime /artifact
CMD ["true"]
