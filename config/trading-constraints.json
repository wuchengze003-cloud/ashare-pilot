{
  "$schema": "trading-constraints/v2",
  "description": "Web、Research 和生产信号共用的 A 股交易与风险约束。支持日线和 5 分钟信号，不排除科创板。",
  "boards": {
    "allowed": ["main", "star", "chinext", "bse"],
    "note": "688 科创板不排除，所有板块统一处理",
    "price_limit_fractions": {
      "main": 0.10,
      "main_st": 0.05,
      "star": 0.20,
      "chinext": 0.20,
      "bse": 0.30
    },
    "symbol_prefixes": {
      "main": ["600", "601", "603", "605", "000", "001", "002", "003"],
      "star": ["688"],
      "chinext": ["300", "301"],
      "bse": ["4", "8", "92"]
    }
  },
  "buy_constraints": {
    "exclude_limit_up": true,
    "limit_slack": 0.003,
    "max_one_day_return_to_buy": 0.095,
    "note": "涨停板不买入；max_one_day_return_to_buy 对主板接近涨停也过滤"
  },
  "risk_management": {
    "initial_capital_yuan": 1000000,
    "max_drawdown_pct": 15,
    "max_single_position_pct": 25,
    "max_single_theme_pct": 40,
    "max_positions": 5,
    "note": "初始资金100万；15%为策略晋级和生产降险上限，不代表未来回撤保证。"
  },
  "execution": {
    "decision_timing": "post_close",
    "execution_price": "next_open",
    "supported_signal_frequencies": ["1d", "5min"],
    "intraday_execution_price": "next_bar_open",
    "t_plus_1": true,
    "lot_size": 100,
    "max_order_bar_amount_pct": 1,
    "min_holding_bars": 5,
    "rebalance_threshold_pct": 5,
    "note": "日线信号默认收盘决策、次日开盘执行；分钟信号必须在5分钟收盘确认后于下一根开盘执行，并遵守T+1。"
  }
}
