    "minimum_median_oos_fold_sharpe": 1.0,
    "minimum_positive_oos_fold_share": 0.75,
    "minimum_oos_annualized_return_pct": 15,
    "minimum_oos_calmar": 1.0,
    "minimum_upside_capture": 0.75,
    "maximum_downside_capture": 0.75,
    "minimum_bootstrap_probability_sharpe_positive": 0.975,
    "double_cost_total_return_must_be_positive": true,
    "minimum_double_cost_oos_sharpe": 0.75,
    "all_required_data_quality_gates_must_pass": true,
    "minute_overlay_must_not_reduce_sharpe": true
