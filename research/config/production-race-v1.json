    "minute_start": "2025-01-01",
    "frequency": ["1d", "5min"],
    "historical_universe": "csi800-point-in-time",
    "historical_universe_file": "runtime/data/reference/csi800.txt",
    "production_universe_file": "../web/data/universe.json"
  },
  "windows": {
    "development": {"start": "2018-01-01", "end": "2022-12-31"},
    "validation": {"start": "2023-01-01", "end": "2024-12-31"},
