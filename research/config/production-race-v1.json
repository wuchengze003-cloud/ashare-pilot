        "trailing_stop_pct": [0.06, 0.08],
        "minimum_volume_ratio": [1.0, 1.25],
        "rebound_from_low_pct": [0]
      }
    },
    {
      "id": "prism-v3",
      "family": "panic_recovery_reversal",
      "description": "市场深弱后广度回升、个股止跌确认的反转，禁止在下跌途中直接抄底",
